<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../Core/Core.csproj" />
    <ProjectReference Include="../../MeridianGit.Abstractions/MeridianGit.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Xml/*.cs" />
    <Compile Include="../Json/*.cs" />
    <Compile Include="../Json5/*.cs" />
    <Compile Include="../Yaml/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Json5" Version="1.0.4" />
    <PackageReference Include="YamlDotNet" Version="17.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>MeridianGit.Formats.Markup</AssemblyName>
    <RootNamespace>MeridianGit.Formats.Markup</RootNamespace>
    <PackageId>MeridianGit.Formats.Markup</PackageId>
    <Authors>Adam Coulter</Authors>
    <Description>XML, JSON, JSON5, and YAML format providers for MeridianGit structural merge and diff.</Description>
    <PackageTags>git;merge;diff;xml;json;json5;yaml;meridiangit-format</PackageTags>
    <PackageProjectUrl>https://github.com/AdamCoulterOz/Meridian</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdamCoulterOz/Meridian</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../Core/Core.csproj" />
    <ProjectReference Include="../../MeridianGit.Abstractions/MeridianGit.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Xap/*.cs" />
    <Compile Include="../Liquid/*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>MeridianGit.Formats.PowerPlatform</AssemblyName>
    <RootNamespace>MeridianGit.Formats.PowerPlatform</RootNamespace>
    <PackageId>MeridianGit.Formats.PowerPlatform</PackageId>
    <Authors>Adam Coulter</Authors>
    <Description>Power Platform-oriented XAP and Liquid format providers for MeridianGit structural merge and diff.</Description>
    <PackageTags>git;merge;diff;powerplatform;xap;liquid;meridiangit-format</PackageTags>
    <PackageProjectUrl>https://github.com/AdamCoulterOz/Meridian</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdamCoulterOz/Meridian</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

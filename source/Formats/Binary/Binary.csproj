<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../Core/Core.csproj" />
    <ProjectReference Include="../../MeridianGit.Abstractions/MeridianGit.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>MeridianGit.Formats.Binary</AssemblyName>
    <RootNamespace>MeridianGit.Formats.Binary</RootNamespace>
    <PackageId>MeridianGit.Formats.Binary</PackageId>
    <Authors>Adam Coulter</Authors>
    <Description>Generic byte-safe binary format provider for MeridianGit structural merge and diff.</Description>
    <PackageTags>git;merge;diff;bin;binary;meridiangit-format</PackageTags>
    <PackageProjectUrl>https://github.com/AdamCoulterOz/Meridian</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdamCoulterOz/Meridian</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

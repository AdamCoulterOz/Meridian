<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../Core/Core.csproj" />
    <ProjectReference Include="../../MeridianGit.Abstractions/MeridianGit.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Png/*.cs" />
    <Compile Include="../Jpeg/*.cs" />
    <Compile Include="../Gif/*.cs" />
    <Compile Include="../Ico/*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>MeridianGit.Formats.Images</AssemblyName>
    <RootNamespace>MeridianGit.Formats.Images</RootNamespace>
    <PackageId>MeridianGit.Formats.Images</PackageId>
    <Authors>Adam Coulter</Authors>
    <Description>Byte-safe image format providers for MeridianGit structural merge and diff.</Description>
    <PackageTags>git;merge;diff;png;jpeg;jpg;gif;ico;binary;meridiangit-format</PackageTags>
    <PackageProjectUrl>https://github.com/AdamCoulterOz/Meridian</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdamCoulterOz/Meridian</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../Core/Core.csproj" />
    <ProjectReference Include="../../MeridianGit.Abstractions/MeridianGit.Abstractions.csproj" />
    <ProjectReference Include="../../Formats/Binary/Binary.csproj" />
    <ProjectReference Include="../../Formats/Images/Images.csproj" />
    <ProjectReference Include="../../Formats/Markup/Markup.csproj" />
    <ProjectReference Include="../../Formats/PowerPlatform/PowerPlatform.csproj" />
    <ProjectReference Include="../../Formats/Web/Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Meridian.Tools.GitMerge</AssemblyName>
    <RootNamespace>Meridian.Tools.GitMerge</RootNamespace>
    <PackageId>MeridianGit</PackageId>
    <Authors>Adam Coulter</Authors>
    <Description>MeridianGit structural merge and diff command-line tool.</Description>
    <PackageTags>git;merge;diff;structural-merge;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/AdamCoulterOz/Meridian</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdamCoulterOz/Meridian</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>meridian</ToolCommandName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
